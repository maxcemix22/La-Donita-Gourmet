<%-- Layout del panel interno. Requiere init.jspf antes y las variables: titulo, seccion. --%>
<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title><c:out value="${titulo}"/> | Panel La Doñita Gourmet</title>
    <link rel="icon" type="image/png" href="${ctx}/recursos/img/logo.png">
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Playfair+Display:ital,wght@0,400;0,600;0,700;1,400&family=Plus+Jakarta+Sans:wght@400;500;600;700&display=swap" rel="stylesheet">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" rel="stylesheet">
    <link href="${ctx}/recursos/css/estilos.css" rel="stylesheet">
</head>
<body class="admin-body">
<c:set var="rolU" value="${usuarioSesion.rol.name()}"/>
<div class="admin-layout">
    <aside class="sidebar-ld" id="sidebar">
        <a class="marca" href="${ctx}/catalogo" title="Ver la tienda">
            <img src="${ctx}/recursos/img/logo.png" alt="La Doñita Gourmet">
            <span><span class="nombre">La Doñita</span><span class="sub">Panel interno</span></span>
        </a>
        <nav class="flex-grow-1 overflow-auto">
            <div class="menu-titulo">Operación</div>
            <c:if test="${rolU != 'REPARTIDOR'}">
                <a class="nav-link ${seccion == 'dashboard' ? 'active' : ''}" href="${ctx}/admin"><i class="bi bi-grid-1x2"></i> Inicio</a>
            </c:if>
            <a class="nav-link ${seccion == 'pedidos' ? 'active' : ''}" href="${ctx}/admin/pedidos">
                <i class="bi bi-receipt"></i> ${rolU == 'REPARTIDOR' ? 'Mis entregas' : 'Pedidos'}</a>
            <c:if test="${rolU != 'REPARTIDOR'}">
                <a class="nav-link ${seccion == 'inventario' ? 'active' : ''}" href="${ctx}/admin/inventario"><i class="bi bi-box-seam"></i> Inventario</a>
                <a class="nav-link ${seccion == 'clientes' ? 'active' : ''}" href="${ctx}/admin/clientes"><i class="bi bi-people"></i> Clientes</a>
            </c:if>
            <c:if test="${rolU == 'ADMIN'}">
                <div class="menu-titulo">Catálogo</div>
                <a class="nav-link ${seccion == 'productos' ? 'active' : ''}" href="${ctx}/admin/productos"><i class="bi bi-basket2"></i> Productos</a>
                <a class="nav-link ${seccion == 'categorias' ? 'active' : ''}" href="${ctx}/admin/categorias"><i class="bi bi-tags"></i> Categorías</a>
                <div class="menu-titulo">Administración</div>
                <a class="nav-link ${seccion == 'usuarios' ? 'active' : ''}" href="${ctx}/admin/usuarios"><i class="bi bi-person-badge"></i> Usuarios</a>
            </c:if>
            <div class="menu-titulo">Análisis</div>
            <a class="nav-link ${seccion == 'reportes' ? 'active' : ''}" href="${ctx}/admin/reportes"><i class="bi bi-bar-chart-line"></i> Reportes</a>
            <div class="menu-titulo">Cuenta</div>
            <a class="nav-link ${seccion == 'perfil' ? 'active' : ''}" href="${ctx}/admin/perfil"><i class="bi bi-shield-lock"></i> Mi perfil</a>
            <a class="nav-link" href="${ctx}/catalogo" target="_blank" rel="noopener"><i class="bi bi-shop"></i> Ver tienda</a>
        </nav>
        <div class="usuario-box d-flex align-items-center gap-2">
            <span class="avatar"><c:out value="${usuarioSesion.nombres.substring(0, 1)}"/></span>
            <div class="flex-grow-1 small lh-sm">
                <div class="fw-semibold text-white"><c:out value="${usuarioSesion.nombreCompleto}"/></div>
                <div class="rol">${usuarioSesion.rol.etiqueta}</div>
            </div>
            <form action="${ctx}/logout" method="post">
                <input type="hidden" name="_csrf" value="${sessionScope.csrfToken}">
                <button class="btn btn-sm text-white-50 p-1" title="Cerrar sesión" aria-label="Cerrar sesión"><i class="bi bi-box-arrow-right fs-5"></i></button>
            </form>
        </div>
    </aside>
    <div class="sidebar-fondo" id="sidebarFondo"></div>
    <div class="admin-main">
        <header class="admin-top">
            <button class="btn btn-suave btn-sm d-lg-none" id="abrirMenu" aria-label="Abrir menú"><i class="bi bi-list fs-5"></i></button>
            <h1><c:out value="${titulo}"/></h1>
            <div class="ms-auto d-flex align-items-center gap-2">
                <c:if test="${applicationScope.modoDemo}"><span class="badge-demo" title="Base de datos H2 embebida">MODO DEMO</span></c:if>
                <span class="small text-muted d-none d-md-inline"><i class="bi bi-calendar3"></i> <span id="fechaHoy"></span></span>
            </div>
        </header>
        <div class="admin-contenido">
<c:if test="${not empty mensaje}">
            <div class="alert alert-${mensajeTipo} alert-dismissible fade show alert-auto shadow-sm" role="alert">
                <c:out value="${mensaje}"/>
                <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Cerrar"></button>
            </div>
</c:if>
