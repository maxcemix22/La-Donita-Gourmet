        </div>
        <footer class="px-4 py-3 small text-muted border-top no-imprimir" style="border-color: var(--ld-borde) !important">
            &copy; 2026 La Doñita Gourmet · Sistema de gestión de pedidos
        </footer>
    </div>
</div>
